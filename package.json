{
  "name": "pos-auto-win",
  "version": "1.0.0",
  "description": "Sistema de Punto de Venta - POSsystem pro",
  "main": "main.js",
  "author": "POSsystem pro",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "prebuild-install": "^7.1.3"
  },
  "build": {
    "appId": "com.autowin.pos",
    "productName": "POSsystem pro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "pos/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "POSsystem-pro-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "POSsystem-pro-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "three": "^0.185.1"
  }
}
